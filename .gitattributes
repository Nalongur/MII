* text=auto

.gitattributes text eol=lf
.gitignore text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.options text eol=lf
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.proto text eol=lf
*.c text eol=lf
*.cc text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
sdkconfig.defaults.* text eol=lf
*.gradle text eol=lf
*.kts text eol=lf
*.kt text eol=lf
*.java text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.sh text eol=lf
gradlew text eol=lf

# Preserve audited upstream nanopb content while ignoring its historical whitespace style.
software/third_party/nanopb/* -text -whitespace
software/firmware/components/mii_protocol/generated/* -text -whitespace
*.md whitespace=-blank-at-eol
*.svg text eol=lf
Kconfig text eol=lf
LICENSE text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.pdf binary
*.zip binary
*.jar binary

# Keep executable Git hooks usable on every platform.
.githooks/* text eol=lf
